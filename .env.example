# Modèle généré par `python docker/env_exemple.py` à partir de .env — ne pas modifier
# à la main. Copier en .env, puis remplacer chaque valeur « password_… ».

# Configuration du projet F1 : pile Docker ET scripts lancés depuis l'hôte.
# Lu par `docker compose` (interpolation de compose.yaml) et par lire_env() des scripts.
# Ignoré par git ; modèle versionné : .env.example (python docker/env_exemple.py).

# --- Utilisateur hôte ----------------------------------------------------------
# Propriétaire des fichiers des volumes (`id -u`, `id -g`) ; groupe du socket Docker
# pour la sauvegarde (`stat -c %g /var/run/docker.sock`).
HOTE_UID=1000
HOTE_GID=1000
DOCKER_GID=1001
TZ=Europe/Luxembourg

# --- Neo4j ---------------------------------------------------------------------
# Édition : community, ou enterprise (contraintes d'existence et de type en base).
NEO4J_EDITION=community
# Enterprise seulement : « yes » (licence commerciale) ou « eval » (évaluation), après
# lecture de la licence Neo4j. Laisser vide en Community.
NEO4J_ACCEPT_LICENSE_AGREEMENT=
NEO4J_USER=neo4j
NEO4J_PASSWORD=password_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
# Mémoire : la limite du conteneur doit couvrir tas + cache de pages + ~1 Go (mémoire
# native de la JVM). En dessous, Neo4j se fige (« stop-the-world pause ») et son
# healthcheck expire : constaté le 29 octobre 2026 avec 2g pour 1g + 512m.
# Le cache de pages devrait contenir la base (environ 540 Mo sur disque).
NEO4J_HEAP=1g
NEO4J_PAGECACHE=768m
NEO4J_MEM_LIMIT=3g

# --- Ports : dans le conteneur (standard), puis sur l'hôte (standard + 1) -------
# Interface de l'hôte où publier : 127.0.0.1 = poste local seulement.
ECOUTE_HOTE=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_HTTP_PORT_HOTE=7475
NEO4J_BOLT_PORT=7687
NEO4J_BOLT_PORT_HOTE=7688
WEB_PORT=8501
WEB_PORT_HOTE=8502

# --- Répertoires de l'hôte (créés par docker/preparer.sh) ------------------------
# Sous WSL, préférer le système de fichiers Linux (~/…) à /mnt/c.
NEO4J_DONNEES_HOTE=./docker-data/neo4j/data
NEO4J_JOURNAUX_HOTE=./docker-data/neo4j/logs
F1_DONNEES_HOTE=./docker-data/donnees
SAUVEGARDES_HOTE=./docker-data/sauvegardes

# --- Chargeur : deltas planifiés ---------------------------------------------------
# Expressions cron séparées par « ; », fuseau TZ : dimanche soir (après la course) et
# lundi matin (classements et corrections publiés).
CRON_DELTA=17 20,23 * * 0;17 7 * * 1
PIPELINE_OPTIONS=--arrets-depuis 2011
CHARGEUR_MEM_LIMIT=1g
# Healthcheck : progrès maximal attendu pendant une exécution (une étape peut attendre
# une heure le quota de l'API) ; âge maximal du dernier delta réussi (plus long écart
# entre deux créneaux, lundi -> dimanche, plus une marge : 8 jours).
SANTE_INACTIVITE_MAX_S=5400
SANTE_AGE_MAX_S=691200

# --- Interface web ------------------------------------------------------------------
WEB_MEM_LIMIT=1g

# --- Sauvegarde : neo4j-admin database dump, rotation ---------------------------
# Chaque nuit à 3 h 45, loin des créneaux des deltas ; Neo4j est arrêté environ une
# minute (exigence du dump en Community).
SAUVEGARDE_CRON=45 3 * * *
SAUVEGARDE_JOURS=7
# Âge maximal de la dernière sauvegarde avant que le service se déclare malade (28 h).
SAUVEGARDE_AGE_MAX_S=100800
# Attente maximale d'un chargement en cours avant de reporter la sauvegarde.
SAUVEGARDE_ATTENTE_MAX_S=3600
SAUVEGARDE_MEM_LIMIT=256m
