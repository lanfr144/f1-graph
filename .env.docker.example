# Modèle : copier en .env.docker (ignoré par git) et renseigner.
#   docker compose --env-file .env.docker up -d --build

# Utilisateur hôte (`id -u`, `id -g`) : propriétaire des fichiers des volumes.
HOTE_UID=1000
HOTE_GID=1000
TZ=Europe/Luxembourg

# Neo4j
NEO4J_PASSWORD=changez-moi-au-moins-8-caracteres
NEO4J_DATABASE=neo4j
# Interface de l'hôte où publier les ports : 127.0.0.1 = poste local seulement.
ECOUTE_HOTE=127.0.0.1
# Ports dans le conteneur, puis sur l'hôte. Choisir des ports hôte libres : un
# autre Neo4j occupe souvent déjà 7474 et 7687.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT_HOTE=7475
NEO4J_BOLT_PORT_HOTE=7688
NEO4J_HEAP=1g
NEO4J_PAGECACHE=512m
NEO4J_MEM_LIMIT=2g

# Interface web (Streamlit) : port dans le conteneur, puis sur l'hôte.
WEB_PORT=8501
WEB_PORT_HOTE=8510
WEB_MEM_LIMIT=1g

# Répertoires de l'hôte (créés par docker/preparer.sh). Sous WSL, préférer le système
# de fichiers Linux (~/…) à /mnt/c : Neo4j y est plus rapide et ses verrous fiables.
NEO4J_DONNEES_HOTE=./docker-data/neo4j/data
NEO4J_JOURNAUX_HOTE=./docker-data/neo4j/logs
F1_DONNEES_HOTE=./docker-data/donnees

# Chargeur : planification des deltas (syntaxe cron, fuseau TZ) et options du pipeline.
CRON_DELTA=17 */6 * * *
PIPELINE_OPTIONS=--arrets-depuis 2011
CHARGEUR_MEM_LIMIT=1g
# Healthcheck du chargeur : progrès maximal attendu pendant une exécution (une étape
# peut attendre une heure le quota de l'API), âge maximal du dernier delta réussi
# (au-delà de deux intervalles du cron, le cron ne tourne plus).
SANTE_INACTIVITE_MAX_S=5400
SANTE_AGE_MAX_S=46800
